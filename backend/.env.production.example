# PM System — Production Environment Variables
# Copy this file to .env.prod on your VPS and fill in the real values
# NEVER commit .env.prod to Git

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Domain (Hostinger free subdomain for your VPS) ───────────────────────────
DOMAIN=srv1860178.hstgr.cloud

# ── Database (PostgreSQL on VPS) ──────────────────────────────────────────────
DB_USER=pm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pm_system

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── URLs (Direct IP access for frontend and backend) ─────────────────────────
FRONTEND_URL=http://200.141.5.248:3000
NEXT_PUBLIC_API_BASE_URL=http://200.141.5.248:5000/api


# ── Email (optional — for password reset emails) ──────────────────────────────
EMAIL_FROM=noreply@srv1860178.hstgr.cloud
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
