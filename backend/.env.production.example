# PM System — Production Environment Variables
# Copy this file to .env.prod on your VPS and fill in the real values
# NEVER commit .env.prod to Git

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (PostgreSQL on VPS) ──────────────────────────────────────────────
DB_USER=pm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pm_system

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── URLs (replace with your actual VPS IP or domain) ─────────────────────────
# If no domain yet, use http://YOUR_VPS_IP
FRONTEND_URL=http://YOUR_VPS_IP_OR_DOMAIN
NEXT_PUBLIC_API_BASE_URL=http://YOUR_VPS_IP_OR_DOMAIN/api

# ── Email (optional — for password reset emails) ──────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail: use an App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=CHANGE_ME_APP_PASSWORD
